{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "source.risingwave-sql",
  "fileTypes": ["rw"],
  "name": "RisingWave SQL",
  "patterns": [
    { "include": "#comments" },
    { "include": "#risingwave-option-blocks" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#risingwave-keywords" },
    { "include": "#risingwave-functions" },
    { "include": "#risingwave-types" },
    { "include": "#postgresql-keywords" },
    { "include": "#postgresql-functions" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.sql",
          "match": "--.*$"
        },
        {
          "name": "comment.block.sql",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.sql",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.sql",
              "match": "''"
            }
          ]
        },
        {
          "name": "string.quoted.double.sql",
          "begin": "\"",
          "end": "\""
        },
        {
          "name": "string.quoted.dollar.sql",
          "begin": "\\$\\$",
          "end": "\\$\\$"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.sql",
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "risingwave-option-blocks": {
      "patterns": [
        {
          "comment": "WITH ( key = value, ... ) option block",
          "begin": "(?i)\\b(WITH)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "keyword.other.postgresql.ddl" },
            "2": { "name": "punctuation.section.parens.begin.sql" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.section.parens.end.sql" }
          },
          "patterns": [{ "include": "#risingwave-option-body" }]
        },
        {
          "comment": "generated:encode-options — ENCODE AVRO ( key = value, ... ) option block",
          "begin": "(?i)\\b(ENCODE)\\s+(PROTOBUF|BYTES|JSON|AVRO|CSV)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "keyword.control.risingwave.format" },
            "2": { "name": "constant.language.risingwave.format" },
            "3": { "name": "punctuation.section.parens.begin.sql" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.section.parens.end.sql" }
          },
          "patterns": [{ "include": "#risingwave-option-body" }]
        }
      ]
    },
    "risingwave-option-body": {
      "patterns": [
        { "include": "#comments" },
        {
          "comment": "generated:connector-value — connector = 'kafka'",
          "match": "(?i)\\b(connector)\\s*(=)\\s*(')(sqlserver-cdc|elasticsearch|postgres-cdc|mongodb-cdc|clickhouse|mysql-cdc|snowflake|starrocks|kinesis|datagen|nexmark|mongodb|iceberg|pulsar|azblob|kafka|doris|delta|redis|jdbc|gcs|s3)(')",
          "captures": {
            "1": { "name": "keyword.control.risingwave.option" },
            "2": { "name": "keyword.operator.comparison.sql" },
            "3": { "name": "string.quoted.single.sql" },
            "4": { "name": "constant.language.risingwave.connector" },
            "5": { "name": "string.quoted.single.sql" }
          }
        },
        { "include": "#strings" },
        { "include": "#numbers" },
        {
          "comment": "generated:option — well-known RisingWave option keys",
          "name": "keyword.control.risingwave.option",
          "match": "(?i)\\b(snapshot\\.batch_size|snapshot\\.interval|primary_key|connector|snapshot|type)\\b(?=\\s*=)"
        },
        {
          "comment": "Any other option key (dotted identifiers like properties.bootstrap.server)",
          "name": "variable.parameter.risingwave.option",
          "match": "\\b[A-Za-z_][A-Za-z0-9_.]*\\b(?=\\s*=)"
        },
        { "include": "#operators" }
      ]
    },
    "risingwave-keywords": {
      "patterns": [
        {
          "comment": "generated:ddl — RisingWave DDL - Sources and Sinks",
          "name": "keyword.control.risingwave.ddl",
          "match": "(?i)\\b(CREATE\\s+MATERIALIZED\\s+VIEW|ALTER\\s+MATERIALIZED\\s+VIEW|DROP\\s+MATERIALIZED\\s+VIEW|CREATE\\s+SOURCE|ALTER\\s+SOURCE|CREATE\\s+SINK|DROP\\s+SOURCE|ALTER\\s+SINK|DROP\\s+SINK)\\b"
        },
        {
          "comment": "generated:streaming — RisingWave streaming keywords",
          "name": "keyword.control.risingwave.streaming",
          "match": "(?i)\\b(EMIT\\s+ON\\s+WINDOW\\s+CLOSE|INCLUDE\\s+TIMESTAMP|INCLUDE\\s+PARTITION|EMIT\\s+IMMEDIATELY|EMIT\\s+ON\\s+UPDATE|WITH\\s+WATERMARK|ASOF\\s+LEFT\\s+JOIN|INCLUDE\\s+OFFSET|INCLUDE\\s+HEADER|WATERMARK\\s+FOR|TEMPORAL\\s+JOIN|INCLUDE\\s+KEY|ASOF\\s+JOIN)\\b"
        },
        {
          "comment": "generated:window — RisingWave window types",
          "name": "keyword.control.risingwave.window",
          "match": "(?i)\\b(SESSION_START|TUMBLE_START|SESSION_END|TUMBLE_END|HOP_START|SESSION|HOP_END|TUMBLE|HOP)\\b"
        },
        {
          "comment": "generated:format — FORMAT <value>",
          "match": "(?i)\\b(FORMAT)\\s+(DEBEZIUM|MAXWELL|UPSERT|PLAIN|CANAL)\\b",
          "captures": {
            "1": { "name": "keyword.control.risingwave.format" },
            "2": { "name": "constant.language.risingwave.format" }
          }
        },
        {
          "comment": "generated:encode — ENCODE <value>",
          "match": "(?i)\\b(ENCODE)\\s+(PROTOBUF|BYTES|JSON|AVRO|CSV)\\b",
          "captures": {
            "1": { "name": "keyword.control.risingwave.format" },
            "2": { "name": "constant.language.risingwave.format" }
          }
        },
        {
          "comment": "generated:format-keywords — bare FORMAT / ENCODE",
          "name": "keyword.control.risingwave.format",
          "match": "(?i)\\b(FORMAT|ENCODE)\\b"
        },
        {
          "comment": "generated:admin — RisingWave admin commands",
          "name": "keyword.control.risingwave.admin",
          "match": "(?i)\\b(SHOW\\s+MATERIALIZED\\s+VIEWS|SHOW\\s+INTERNAL\\s+TABLES|SHOW\\s+CLUSTERS|SHOW\\s+SOURCES|CANCEL\\s+JOBS|SHOW\\s+SINKS|CANCEL\\s+JOB|SHOW\\s+JOBS|RECOVER|RISECTL|RESUME|FLUSH|PAUSE)\\b"
        }
      ]
    },
    "risingwave-functions": {
      "patterns": [
        {
          "comment": "generated:functions — RisingWave-specific functions (PostgreSQL functions are in #postgresql-functions)",
          "name": "support.function.risingwave",
          "match": "(?i)\\b(proctime)\\b"
        }
      ]
    },
    "risingwave-types": {
      "patterns": [
        {
          "comment": "generated:types — RisingWave data types",
          "name": "storage.type.risingwave",
          "match": "(?i)\\b(TIMESTAMP\\s+WITH\\s+TIME\\s+ZONE|TIMESTAMPTZ|RWTIMESTAMP|STRUCT|JSONB|BYTEA)\\b"
        }
      ]
    },
    "postgresql-keywords": {
      "patterns": [
        {
          "comment": "PostgreSQL DML",
          "name": "keyword.other.postgresql.dml",
          "match": "(?i)\\b(SELECT|INSERT|UPDATE|DELETE|FROM|WHERE|AND|OR|NOT|IN|EXISTS|BETWEEN|LIKE|ILIKE|IS|NULL|TRUE|FALSE|CASE|WHEN|THEN|ELSE|END|AS|ON|USING|NATURAL|CROSS|INNER|LEFT|RIGHT|FULL|OUTER|JOIN|GROUP\\s+BY|HAVING|ORDER\\s+BY|LIMIT|OFFSET|FETCH|FIRST|NEXT|ROWS?|ONLY|UNION|INTERSECT|EXCEPT|ALL|DISTINCT|INTO|VALUES|SET|RETURNING)\\b"
        },
        {
          "comment": "PostgreSQL DDL",
          "name": "keyword.other.postgresql.ddl",
          "match": "(?i)\\b(CREATE|ALTER|DROP|TABLE|VIEW|INDEX|SCHEMA|DATABASE|SEQUENCE|FUNCTION|PROCEDURE|TRIGGER|TYPE|DOMAIN|CONSTRAINT|PRIMARY\\s+KEY|FOREIGN\\s+KEY|UNIQUE|CHECK|DEFAULT|REFERENCES|CASCADE|RESTRICT|NO\\s+ACTION|IF\\s+EXISTS|IF\\s+NOT\\s+EXISTS|WITH|WITHOUT)\\b"
        },
        {
          "comment": "PostgreSQL transaction",
          "name": "keyword.other.postgresql.transaction",
          "match": "(?i)\\b(BEGIN|COMMIT|ROLLBACK|SAVEPOINT|RELEASE|TRANSACTION|ISOLATION|LEVEL|READ|WRITE|COMMITTED|UNCOMMITTED|REPEATABLE|SERIALIZABLE)\\b"
        },
        {
          "comment": "PostgreSQL data types",
          "name": "storage.type.postgresql",
          "match": "(?i)\\b(BOOLEAN|BOOL|SMALLINT|INT2|INTEGER|INT|INT4|BIGINT|INT8|REAL|FLOAT4|DOUBLE\\s+PRECISION|FLOAT8|NUMERIC|DECIMAL|CHAR|CHARACTER|VARCHAR|CHARACTER\\s+VARYING|TEXT|DATE|TIME|TIMESTAMP|INTERVAL|UUID|SERIAL|BIGSERIAL|SMALLSERIAL|ARRAY|JSON|XML)\\b"
        }
      ]
    },
    "postgresql-functions": {
      "patterns": [
        {
          "comment": "PostgreSQL aggregate functions",
          "name": "support.function.postgresql.aggregate",
          "match": "(?i)\\b(COUNT|SUM|AVG|MIN|MAX|ARRAY_AGG|STRING_AGG|BOOL_AND|BOOL_OR|BIT_AND|BIT_OR|EVERY|COALESCE|NULLIF|GREATEST|LEAST)\\b"
        },
        {
          "comment": "PostgreSQL string functions",
          "name": "support.function.postgresql.string",
          "match": "(?i)\\b(CONCAT|LENGTH|LOWER|UPPER|TRIM|LTRIM|RTRIM|SUBSTRING|SUBSTR|REPLACE|POSITION|SPLIT_PART|REGEXP_REPLACE|REGEXP_MATCH|LEFT|RIGHT|REPEAT|REVERSE|LPAD|RPAD|INITCAP|TRANSLATE|OVERLAY)\\b"
        },
        {
          "comment": "PostgreSQL date/time functions",
          "name": "support.function.postgresql.datetime",
          "match": "(?i)\\b(CURRENT_DATE|CURRENT_TIME|CURRENT_TIMESTAMP|NOW|LOCALTIME|LOCALTIMESTAMP|DATE_TRUNC|DATE_PART|EXTRACT|AGE|MAKE_DATE|MAKE_TIME|MAKE_TIMESTAMP|TO_CHAR|TO_DATE|TO_TIMESTAMP|DATE_ADD|DATE_SUB)\\b"
        },
        {
          "comment": "PostgreSQL JSON functions",
          "name": "support.function.postgresql.json",
          "match": "(?i)\\b(JSON_BUILD_OBJECT|JSON_BUILD_ARRAY|JSON_AGG|JSONB_BUILD_OBJECT|JSONB_BUILD_ARRAY|JSONB_AGG|JSON_EXTRACT_PATH|JSONB_EXTRACT_PATH|JSON_EXTRACT_PATH_TEXT|JSONB_EXTRACT_PATH_TEXT|JSON_ARRAY_LENGTH|JSONB_ARRAY_LENGTH|JSON_TYPEOF|JSONB_TYPEOF|TO_JSON|TO_JSONB|ROW_TO_JSON)\\b"
        },
        {
          "comment": "PostgreSQL window functions",
          "name": "support.function.postgresql.window",
          "match": "(?i)\\b(ROW_NUMBER|RANK|DENSE_RANK|PERCENT_RANK|CUME_DIST|NTILE|LAG|LEAD|FIRST_VALUE|LAST_VALUE|NTH_VALUE)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.sql",
          "match": "(=|<>|!=|<|>|<=|>=)"
        },
        {
          "name": "keyword.operator.arithmetic.sql",
          "match": "(\\+|-|\\*|/|%|\\^)"
        },
        {
          "name": "keyword.operator.json.sql",
          "match": "(->|->>|#>|#>>|@>|<@|\\?|\\?\\||\\?&|\\|\\||&&)"
        },
        {
          "name": "keyword.operator.assignment.sql",
          "match": ":="
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.sql",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
